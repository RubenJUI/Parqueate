PGNAMEDATABASE=parqueadero_autos_colombia
PGUSER=parqueate
PGHOST=localhost
PGPASSWORD=
PGPORT=5432
# "prefer" en local; usar "require" con proveedores cloud como Neon.
PGSSLMODE=prefer

SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origenes permitidos para CORS separados por coma; "*" permite cualquiera.
ALLOWED_ORIGINS=http://localhost:5173

# Dias de vigencia de la mensualidad y dias de anticipacion de la alerta de vencimiento.
DIAS_VIGENCIA=30
DIAS_ALERTA=3
